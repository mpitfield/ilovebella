---
import Layout from '../layouts/Layout.astro';

// Temporary visual reference. Delete this file when it is no longer useful.
// These values render at build time; this page has no client-side JavaScript.
const placeholder = 'data:image/svg+xml,' + encodeURIComponent(
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400"><rect width="400" height="400" fill="#DCE2C3"/><circle cx="200" cy="170" r="70" fill="#FFF9F1"/><text x="200" y="300" text-anchor="middle" font-family="sans-serif" font-size="24" fill="#4C342E">Photo placeholder</text></svg>'
);
const colours = ['vanilla-cream', 'strawberry-pink', 'powder-blush', 'soft-sage', 'coffee-brown', 'ink'];
const heartPath = 'M12 21S3 15 3 8a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 7-9 13-9 13Z';
---

<Layout title="Temporary style guide · ilovebella.boo">
  <div class="site-container section">
    <div class="stack">
      <p class="eyebrow">Temporary CSS reference</p>
      <h1 class="page-title">Style guide</h1>
      <p class="lede">Existing theme classes, with placeholder content. Buttons and filters are visual samples only.</p>
    </div>

    <section class="section section--small stack">
      <h2 class="section-title">Colours / typography</h2>
      <div class="cluster">
        {colours.map((colour) => (
          <figure>
            <svg width="120" height="64" viewBox="0 0 120 64" aria-hidden="true">
              <rect width="120" height="64" fill={`var(--${colour})`} />
            </svg>
            <figcaption><small>{colour}</small></figcaption>
          </figure>
        ))}
      </div>
      <p class="font-body">font-body — readable body text, <strong>bold</strong> and <em>italic</em>.</p>
      <p class="font-handwritten">font-handwritten — a short handwritten line.</p>
      <p class="handwritten">handwritten — a little larger.</p>
      <p class="annotation">annotation — a small side note.</p>
      <p class="eyebrow">eyebrow — a quiet label</p>
      <p class="lede">lede — introductory copy. The headings above use page-title and section-title.</p>
    </section>

    <section class="section section--small stack">
      <h2 class="section-title">Buttons</h2>
      <div class="cluster">
        <button type="button" class="btn">btn</button>
        {['primary', 'paper', 'outline', 'text'].map((variant) => (
          <button type="button" class={`btn btn--${variant}`}>{`btn--${variant}`}</button>
        ))}
        <button type="button" class="btn btn--heart" aria-label="Heart button" aria-pressed="false">
          <svg class="heart" viewBox="0 0 24 24" aria-hidden="true"><path d={heartPath} /></svg>
        </button>
        <button type="button" class="btn btn--heart" aria-label="Selected heart button" aria-pressed="true">
          <svg class="heart heart--filled" viewBox="0 0 24 24" aria-hidden="true"><path d={heartPath} /></svg>
        </button>
        <button type="button" class="btn btn--primary" disabled>Disabled</button>
      </div>
      <p>Hover, press, or use Tab to see the existing interaction states.</p>
    </section>

    <section class="section section--small stack">
      <h2 class="section-title">Paper styles</h2>
      <div class="memory-grid">
        <div class="paper">paper — plain</div>
        {['cream', 'pink', 'blush', 'sage', 'lined', 'torn', 'rotated-left', 'rotated-right'].map((variant) => (
          <div class={`paper paper--${variant}`}><p>{`paper--${variant}`}</p></div>
        ))}
      </div>
    </section>

    <section class="section section--small stack">
      <h2 class="section-title">Polaroids</h2>
      <div class="memory-grid">
        {[
          ['', 'Square'],
          ['polaroid--portrait polaroid--left', 'Portrait · left'],
          ['polaroid--landscape polaroid--right', 'Landscape · right'],
          ['polaroid--taped', 'Taped'],
        ].map(([classes, caption]) => (
          <figure class={`polaroid ${classes}`}>
            <img class="polaroid__image" src={placeholder} alt="Neutral photo placeholder" width="400" height="400" />
            <figcaption class="polaroid__caption">{caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="section section--small stack">
      <h2 class="section-title">Notes</h2>
      <div class="memory-grid">
        <aside class="note"><p>note — plain scrap</p></aside>
        <aside class="note note--sticky note--pink"><p class="handwritten">Sticky · pink</p></aside>
        <aside class="note note--sticky note--sage"><p class="handwritten">Sticky · sage</p></aside>
        <aside class="note note--paper"><p>note--paper</p></aside>
        <aside class="note note--lined"><p>note--lined</p><p>A second line.</p></aside>
        <aside class="note note--torn"><p class="annotation">Torn scrap</p></aside>
        <aside class="note note--heart"><p class="handwritten">Heart note</p></aside>
      </div>
    </section>

    <section class="section section--small stack">
      <h2 class="section-title">Stats / counters</h2>
      <p>Static sample numbers.</p>
      <dl class="counter">
        {['Years', 'Months', 'Days', 'Hours', 'Minutes', 'Seconds'].map((label, index) => (
          <div class="counter__item">
            <dt class="counter__label">{label}</dt>
            <dd class="counter__number">{index + 1}</dd>
          </div>
        ))}
      </dl>
      <div class="memory-grid">
        {['pink', 'sage', 'cream'].map((variant) => (
          <div class={`stat stat--${variant}`}>
            <span class="stat__number">123</span>
            <span class="stat__label">{`stat--${variant}`}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="section section--small stack">
      <h2 class="section-title">Memory / gallery items</h2>
      <p>memory-grid with memory-grid--dense; resize to see the responsive columns.</p>
      <div class="memory-grid memory-grid--dense">
        {[
          ['', 'Square'],
          ['memory--portrait', 'Portrait'],
          ['memory--landscape', 'Landscape'],
          ['memory--favourite', 'Favourite'],
          ['rotate-slight-right', 'Slight rotation'],
        ].map(([classes, caption]) => (
          <figure class={`memory ${classes}`}>
            <img class="memory__image" src={placeholder} alt="Neutral gallery placeholder" width="400" height="400" loading="lazy" />
            <figcaption>
              <time class="memory__date" datetime="2026-01-01">1 January 2026</time>
              <p class="memory__caption">{caption}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="section section--small stack">
      <h2 class="section-title">Timeline</h2>
      <ol class="timeline">
        {[1, 2, 3].map((item) => (
          <li class="timeline__item">
            <span class="timeline__marker" aria-hidden="true"></span>
            <time class="timeline__date" datetime={`2026-0${item}-01`}>Sample date {item}</time>
            <div class="timeline__content paper">
              <h3>Milestone placeholder</h3>
              <p>A short description.</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="section section--small stack">
      <h2 class="section-title">Forms / filters</h2>
      <div class="memory-grid">
        <div class="field search">
          <label class="field__label" for="sample-search">Search</label>
          <input id="sample-search" type="search" placeholder="Search placeholder" aria-describedby="search-hint" />
          <p class="field__hint" id="search-hint">field__hint — helper text.</p>
        </div>
        <div class="field">
          <label class="field__label" for="sample-select">Select</label>
          <select id="sample-select"><option>First option</option><option>Second option</option></select>
        </div>
        <div class="field">
          <label class="field__label" for="sample-error">Invalid input</label>
          <input id="sample-error" value="Sample value" aria-invalid="true" aria-describedby="sample-error-message" />
          <p class="field__error" id="sample-error-message">Example error message.</p>
        </div>
        <div class="field">
          <label class="field__label" for="sample-disabled">Disabled input</label>
          <input id="sample-disabled" value="Disabled" disabled />
        </div>
      </div>
      <div class="field search">
        <label class="field__label" for="sample-message">Textarea</label>
        <textarea id="sample-message" placeholder="A little note..."></textarea>
      </div>
      <div class="cluster">
        <label class="check-label"><input type="checkbox" checked /> Checkbox</label>
        <label class="check-label"><input type="radio" name="sample-radio" checked /> First</label>
        <label class="check-label"><input type="radio" name="sample-radio" /> Second</label>
      </div>
      <div class="cluster">
        <button type="button" class="filter" aria-pressed="false">filter</button>
        <button type="button" class="filter filter--active" aria-pressed="true">filter--active</button>
        <button type="button" class="filter" disabled>Disabled filter</button>
      </div>
    </section>

    <section class="section section--small stack">
      <h2 class="section-title">Decorations / rotation / tape</h2>
      <div class="cluster">
        <span class="sticker">sticker</span>
        <svg class="heart" viewBox="0 0 24 24" role="img" aria-label="Outlined heart"><path d={heartPath} /></svg>
        <svg class="heart heart--filled" viewBox="0 0 24 24" role="img" aria-label="Filled heart"><path d={heartPath} /></svg>
        <svg class="doodle" viewBox="0 0 24 24" role="img" aria-label="Doodle arrow">
          <path d="M2 18Q8 4 20 8M14 3L21 8 15 14" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
        <span class="tape" aria-hidden="true"></span>
        <span class="tape tape--left" aria-hidden="true"></span>
        <span class="tape tape--right" aria-hidden="true"></span>
      </div>
      <div class="cluster">
        {['rotate-left', 'rotate-right', 'rotate-slight-left', 'rotate-slight-right'].map((rotation) => (
          <div class={`paper ${rotation}`}>{rotation}</div>
        ))}
      </div>
    </section>

    <section class="section section--small stack">
      <h2 class="section-title">Layout / overlapping photos</h2>
      <p>This page uses site-container, section, section--small, stack and cluster.</p>
      <div class="site-container site-container--wide paper">site-container--wide</div>
      <div class="site-container site-container--narrow stack">
        <p>site-container--narrow / photo-cluster</p>
        <div class="photo-cluster">
          {['polaroid--left', 'polaroid--right'].map((rotation) => (
            <figure class={`polaroid ${rotation}`}>
              <img class="polaroid__image" src={placeholder} alt="Overlapping photo placeholder" width="400" height="400" loading="lazy" />
              <figcaption class="polaroid__caption">Overlapping photo</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--small stack">
      <h2 class="section-title">Motion / hover effects</h2>
      <p>Hover the samples. Entrance effects run once on page load; reload here to see them. Reduced-motion preferences apply.</p>
      <div class="memory-grid">
        <div class="paper lift">lift — hover me</div>
        <div class="paper wiggle-hover">wiggle-hover — hover me</div>
        <div class="paper paper-enter">paper-enter</div>
        <figure class="polaroid photo-enter">
          <img class="polaroid__image" src={placeholder} alt="Entrance effect placeholder" width="400" height="400" />
          <figcaption class="polaroid__caption">photo-enter</figcaption>
        </figure>
      </div>
    </section>
  </div>
</Layout>
